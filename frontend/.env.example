# Frontend settings. Copy to frontend/.env (git-ignored); every value is also the default.
#
# Never put a secret here: any VITE_* variable that app code reads is compiled into the
# JavaScript bundle and visible to every user. Secrets belong to the backend (backend/.env).

# [config] Where the Vite dev server proxies /api requests (`make dev-web`).
VITE_API_PROXY=http://localhost:8000
