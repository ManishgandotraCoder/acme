# docker-compose settings. Copy to .env (git-ignored) next to docker-compose.yml; Compose
# reads it automatically. Every value below is also the default, so this file is optional.
# Backend settings live in backend/.env (see backend/.env.example).
#
# [SECRET]  never commit a real value.
# [config]  safe to commit.

# --- Local PostgreSQL (`make db-up`) -----------------------------------------------------
# [config]
POSTGRES_USER=salary
# [SECRET] Only reachable from this machine; change it if you expose the port.
POSTGRES_PASSWORD=salary
# [config]
POSTGRES_DB=salary
# [config] Host port. 5433 avoids clashing with a locally installed Postgres.
POSTGRES_PORT=5433
# backend/.env's SALARY_DATABASE_URL must use the same user, password, port and database.

# --- Full stack (`make docker-up`) -------------------------------------------------------
# [config] Host port for the app (UI + API).
APP_PORT=8000
# [config] Model Ollama pulls on start-up and the app uses.
OLLAMA_MODEL=llama3.2
