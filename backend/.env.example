# Copy to backend/.env to override defaults (see app/core/config.py).
# Postgres from docker-compose (`make db-up`). Format: postgresql+psycopg://user:pass@host:port/db
SALARY_DATABASE_URL=postgresql+psycopg://salary:salary@localhost:5433/salary
SALARY_LOG_LEVEL=INFO
SALARY_CORS_ORIGINS=["http://localhost:5173"]
# Language models that classify questions. Ollama is always offered and the default; Claude and
# OpenAI are offered (and selectable in the chat) only when their key is set. Never commit keys.
SALARY_LLM_PROVIDER=ollama
SALARY_LLM_TIMEOUT_SECONDS=30
SALARY_OLLAMA_URL=http://localhost:11434
SALARY_OLLAMA_MODEL=llama3.2
# ANTHROPIC_API_KEY=
# SALARY_ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# SALARY_OPENAI_MODEL=gpt-4.1-mini
# Who the app acts as until SSO exists; drop view_individual_pay to test the restricted view.
# SALARY_ACTOR_NAME=HR Manager
# SALARY_ACTOR_PERMISSIONS=["view_individual_pay"]
# Serve the built UI from the API (production / Docker):
# SALARY_STATIC_DIR=../frontend/dist
