# Backend settings. Copy to backend/.env (git-ignored) and adjust; every value below is also
# the default in app/core/config.py, except where noted. Read by `make dev-api`, Alembic, the
# seed script, and the app container in docker-compose.
#
# [SECRET]  never commit a real value: keep it in backend/.env locally, and in the host's
#           secret store (Render dashboard, GitHub Actions secrets) when deployed.
# [config]  safe to commit; Render's are in render.yaml.

# --- Database ---------------------------------------------------------------------------
# [SECRET] PostgreSQL. The default is the docker-compose database (`make db-up`); its user,
# password and port must match POSTGRES_* in the root .env. A hosted URL such as Neon's
# (postgresql://user:password@host/db?sslmode=require) works as given.
SALARY_DATABASE_URL=postgresql+psycopg://salary:salary@localhost:5433/salary

# --- HTTP -------------------------------------------------------------------------------
# [config]
SALARY_LOG_LEVEL=INFO
# [config] Browser origins allowed to call the API directly (the Vite dev server).
SALARY_CORS_ORIGINS=["http://localhost:5173"]
# [config] Serve the built UI from the API (production / Docker sets this itself).
# SALARY_STATIC_DIR=../frontend/dist

# --- Language models (Ask Salary Data) --------------------------------------------------
# [config] Default provider: ollama | anthropic | openai. Ollama is always offered; Claude and
# OpenAI only when their key is set.
SALARY_LLM_PROVIDER=ollama
SALARY_LLM_TIMEOUT_SECONDS=30
SALARY_OLLAMA_URL=http://localhost:11434
SALARY_OLLAMA_MODEL=llama3.2
# [SECRET] API keys (SALARY_ANTHROPIC_API_KEY / SALARY_OPENAI_API_KEY also work).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# [config]
# SALARY_ANTHROPIC_MODEL=claude-opus-5-5
# SALARY_OPENAI_MODEL=gpt-4.1-mini

# --- Acting user, until SSO exists (app/core/actor.py) -----------------------------------
# [config] Drop view_individual_pay to try the restricted view.
# SALARY_ACTOR_NAME=HR Manager
# SALARY_ACTOR_PERMISSIONS=["view_individual_pay"]

# --- Tests ------------------------------------------------------------------------------
# [config] Run the tests against an existing database instead of a throwaway container.
# Everything in it is dropped. Never point this at a database you care about.
# SALARY_TEST_DATABASE_URL=postgresql+psycopg://salary:salary@localhost:5433/salary_test
